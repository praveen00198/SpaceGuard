# SpaceGuard AI — Frontend Environment Configuration
# Copy to .env.local for local overrides.
#
# Development (default with Vite proxy):
# Leave both empty to use the Vite local dev server proxy to http://localhost:3001
VITE_API_URL=
VITE_WS_URL=

# Split / Production Deployment:
# Set to the backend public URL (e.g. Render / Railway / custom domain)
# VITE_API_URL=https://api.spaceguard.example.com
# VITE_WS_URL=https://api.spaceguard.example.com
