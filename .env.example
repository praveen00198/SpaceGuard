# ============================================================
# SpaceGuard AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# --- General ---
NODE_ENV=development
LOG_LEVEL=info

# --- Backend ---
BACKEND_PORT=3001
BACKEND_HOST=localhost

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=
VITE_WS_URL=

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/spaceguard
MONGODB_DB_NAME=spaceguard

# --- ML Service ---
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_PORT=8000

# --- Gemini AI ---
# Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- NASA APIs ---
# Obtain from https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# --- SatNOGS ---
# Obtain from https://db.satnogs.org/ (Settings > API Key)
SATNOGS_API_TOKEN=

# --- NOAA SWPC ---
# Public endpoints — no key required
NOAA_SWPC_BASE_URL=https://services.swpc.noaa.gov

# --- CelesTrak ---
# Public endpoints — no key required
CELESTRAK_BASE_URL=https://celestrak.org

# --- WebSocket ---
WS_CORS_ORIGIN=http://localhost:5173

# --- Security ---
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100
CORS_ORIGIN=http://localhost:5173




# --- To download dataset ---
# ---- 1.  python scripts/data/download_nasa_dataset.py --output data/raw/nasa-smap-msl/ ----
# --- 2.  python scripts/data/download_space_weather.py --output data/raw/space-weather/ ---